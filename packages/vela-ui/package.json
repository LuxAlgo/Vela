{
  "name": "@luxalgo/vela-ui",
  "version": "0.1.0",
  "description": "The component kit of Vela: one file per component, Zag state machines for behavior, CSS in cascade layers over design tokens.",
  "license": "Apache-2.0",
  "author": "LuxAlgo",
  "homepage": "https://velacharts.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxalgo/vela.git",
    "directory": "packages/vela-ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tabs": "^1.42.0",
    "@zag-js/toggle-group": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0"
  },
  "keywords": [
    "ui components",
    "design tokens",
    "cascade layers",
    "zag",
    "vela",
    "luxalgo"
  ]
}
