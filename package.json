{
  "name": "@luxalgo/vela",
  "version": "0.6.12",
  "description": "Open-source charting library with a native high-performance renderer, drawing tools, pluggable chart types and pluggable scripting engines.",
  "license": "Apache-2.0",
  "homepage": "https://luxalgo.com/vela",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxalgo/vela.git"
  },
  "bugs": {
    "url": "https://github.com/luxalgo/vela/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/binance": {
      "types": "./dist/providers/binance.d.ts",
      "import": "./dist/providers/binance.js",
      "require": "./dist/providers/binance.cjs"
    },
    "./providers/hyperliquid": {
      "types": "./dist/providers/hyperliquid.d.ts",
      "import": "./dist/providers/hyperliquid.js",
      "require": "./dist/providers/hyperliquid.cjs"
    },
    "./providers/coinbase": {
      "types": "./dist/providers/coinbase.d.ts",
      "import": "./dist/providers/coinbase.js",
      "require": "./dist/providers/coinbase.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "author": "LuxAlgo",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "playground": "vite"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0"
  }
}
