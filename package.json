{
  "name": "@luxalgo/vela",
  "version": "0.10.3",
  "description": "The open-source core of Vela by LuxAlgo: a charting library with a native high-performance renderer, drawing tools, pluggable chart types and pluggable scripting engines.",
  "keywords": [
    "charting library",
    "financial charts",
    "trading charts",
    "candlestick chart",
    "stock chart",
    "crypto chart",
    "webgl",
    "canvas",
    "technical analysis",
    "indicators",
    "drawing tools",
    "orderflow",
    "pine script",
    "pinets",
    "lightweight-charts alternative",
    "typescript",
    "luxalgo",
    "vela"
  ],
  "license": "Apache-2.0",
  "homepage": "https://velacharts.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxAlgo/Vela.git"
  },
  "bugs": {
    "url": "https://github.com/luxalgo/vela/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/binance": {
      "types": "./dist/providers/binance.d.ts",
      "import": "./dist/providers/binance.js",
      "require": "./dist/providers/binance.cjs"
    },
    "./providers/hyperliquid": {
      "types": "./dist/providers/hyperliquid.d.ts",
      "import": "./dist/providers/hyperliquid.js",
      "require": "./dist/providers/hyperliquid.cjs"
    },
    "./providers/coinbase": {
      "types": "./dist/providers/coinbase.d.ts",
      "import": "./dist/providers/coinbase.js",
      "require": "./dist/providers/coinbase.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js",
      "require": "./dist/locales/*.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "llms.txt",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "author": "LuxAlgo",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build -w @luxalgo/vela-ui && tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/lint-css.mjs",
    "playground": "vite",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "lint:css": "node scripts/lint-css.mjs",
    "new-component": "node packages/vela-ui/scripts/new-component.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "postcss-lit": "^1.4.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@luxalgo/vela-ui": "^0.3.0"
  },
  "skills": [
    "npm:@luxalgo/vela-ui"
  ],
  "workspaces": [
    "packages/*"
  ]
}
